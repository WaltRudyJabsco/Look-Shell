#!/usr/bin/env python3
import os, platform, shutil, subprocess, sys, termios, tty
from pathlib import Path
VERSION="0.4.5"
HOME=Path.home()
ROOT=Path(__file__).resolve().parent
RENDERER=ROOT/"look_renderer.py"

def render(args):
    return subprocess.call([sys.executable,str(RENDERER),*args])

def _page_text(body: str) -> int:
    """Page long system text only when it exceeds the current terminal."""
    lines = body.rstrip("\n").splitlines()
    height = max(6, shutil.get_terminal_size((80, 24)).lines - 1)

    # Non-interactive output should stay pipe-friendly.
    if len(lines) <= height or not sys.stdin.isatty() or not sys.stdout.isatty():
        print(body, end="" if body.endswith("\n") else "\n")
        return 0

    top = 0
    old = termios.tcgetattr(sys.stdin.fileno())
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            os.system("clear")
            page = lines[top:top + height - 1]
            sys.stdout.write("\n".join(page))
            sys.stdout.write(
                f"\n\033[2m{min(top + height - 1, len(lines))}/{len(lines)}"
                " · Space next · b back · g/G ends · q quit\033[0m"
            )
            sys.stdout.flush()

            ch = sys.stdin.read(1)
            if ch == "q":
                break
            if ch == " ":
                if top + height - 1 >= len(lines):
                    break
                top = min(len(lines) - 1, top + height - 1)
            elif ch == "b":
                top = max(0, top - (height - 1))
            elif ch == "g":
                top = 0
            elif ch == "G":
                top = max(0, len(lines) - (height - 1))
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\n")
        sys.stdout.flush()
    return 0


def help_screen():
    body = f"""
       ██╗      ██╗  ██╗
       ██║      ██║ ██╔╝
       ██║      █████╔╝
       ██║      ██╔═██╗
       ███████╗ ██║  ██╗
       ╚══════╝ ╚═╝  ╚═╝

       LOOK {VERSION} · filesystem, navigation, shell

FILES
  lk [PATH]            smart view
  lk detail [PATH]     detailed view
  lk dirs [PATH]       directories
  lk files [PATH]      files
  lk tree [PATH]       tree
  lk recent [PATH]     newest first
  lk size [PATH]       size-oriented

