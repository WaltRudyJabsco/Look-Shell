def _human_size(size):
    if size < 1024: return f"{size} B"
    if size < 1024**2: return f"{size/1024:.1f} KB"
    if size < 1024**3: return f"{size/1024**2:.1f} MB"
    return f"{size/1024**3:.1f} GB"


def _file_preview_lines(p, kind):
    """Return a generous but bounded preview for the interactive file card."""
    suffix=p.suffix.lower()
    textish = (
        kind.startswith('ASCII') or 'text' in kind.lower() or 'script' in kind.lower()
        or suffix in {'.md','.txt','.py','.js','.ts','.tsx','.jsx','.json','.toml','.yaml','.yml',
                      '.html','.css','.sh','.zsh','.c','.h','.cpp','.rs','.go','.lua','.sql','.csv'}
    )
    if textish and p.stat().st_size <= 2_000_000:
        try:
            lines=p.read_text(encoding='utf-8',errors='replace').splitlines()
            return ["", "  PREVIEW"] + ["  "+line[:220] for line in lines[:400]] + (
                [f"  … {len(lines)-400} more lines"] if len(lines)>400 else []
            )
        except OSError:
            return []
    if suffix=='.pdf' and shutil.which('pdftotext'):
        try:
            r=subprocess.run(['pdftotext','-f','1','-l','3','-layout',str(p),'-'],
                             capture_output=True,text=True,timeout=3)
            lines=[x.rstrip() for x in r.stdout.splitlines() if x.strip()]
            if lines:
                return ["", "  PDF PREVIEW"] + ["  "+line[:220] for line in lines[:250]]
        except (OSError,subprocess.SubprocessError):
            pass
    return []


def _copy_path(path):
    value=str(path)
    try:
        if platform.system()=="Darwin" and shutil.which("pbcopy"):
            subprocess.run(["pbcopy"],input=value,text=True,check=True)
            return True
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"],input=value,text=True,check=True)
            return True
        if shutil.which("xclip"):
            subprocess.run(["xclip","-selection","clipboard"],input=value,text=True,check=True)
            return True
    except (OSError,subprocess.SubprocessError):
        pass
    return False


def _copy_file_clipboard(path):
    p=Path(path).expanduser().resolve()
    try:
        if platform.system()=="Darwin" and shutil.which("osascript"):
            quoted=json.dumps(str(p))
            script=f'set the clipboard to {{(POSIX file {quoted}) as alias}}'
            subprocess.run(["osascript","-e",script],check=True,
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return True
        uri=p.as_uri()+"\r\n"
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy","--type","text/uri-list"],input=uri,text=True,check=True)
            return True
        if shutil.which("xclip"):
            subprocess.run(["xclip","-selection","clipboard","-t","text/uri-list"],
                           input=uri,text=True,check=True)
            return True
    except (OSError,subprocess.SubprocessError):
        pass
    return False


def _open_file(path, choose=False):
    try:
        if platform.system()=="Darwin":
            if choose:
                # `open -a` needs an app name; keep LOOK's card simple and use
                # the default app here. The filesystem browser still provides
                # the richer O/open-with chooser.
                return subprocess.call(["open",str(path)])
            return subprocess.call(["open",str(path)])
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open",str(path)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return 0
    except OSError:
        pass
    return 1


def _edit_file(path):
    editor=os.environ.get("EDITOR") or os.environ.get("VISUAL") or shutil.which("nvim") or shutil.which("vim")
    if not editor:
        print("LOOK: no editor found (set $EDITOR).")
        return 1
    try:
        return subprocess.call([editor,str(path)])
    except OSError as exc:
        print(f"LOOK: editor failed: {exc}")
        return 1


def _mutate_file(path, action):
    """Explicit file mutation from the file card; all local LOOK mutations share one undo journal."""
    p=Path(path)
    if action in {"move","copy","send"}:
        label={"move":"to","copy":"to","send":"to (host:path)"}[action]
        try:
            dest,cancelled=_prompt_line(f"{label} › ")
        except KeyboardInterrupt:
            return
        dest=dest.strip()
        if cancelled or not dest:
            return
        if action=="move":
            print(_journal_move(p,dest))
        elif action=="copy":
            print(_journal_copy(p,dest))
        else:
            cmd=["scp",str(p),dest]
            if p.is_dir(): cmd=["scp","-r",str(p),dest]
            subprocess.call(cmd)
        return
    if action=="remove":
        try:
            answer,cancelled=_prompt_line(f"remove {p.name}? [r confirms · Esc/Enter cancels] › ")
        except KeyboardInterrupt:
            return
        if cancelled or answer.strip().lower()!="r":
            return
        print(_journal_remove(p))


def _file_card_lines(p):
    p=Path(p).expanduser().resolve()
    st=p.stat()
    kind=_run_text(['file','-b',str(p)]) if shutil.which('file') else ''
    lines=[
        f"{p.name} · file",
        "",
        f"  path     {p}",
        f"  size     {_human_size(st.st_size)}",
        f"  mode     {oct(st.st_mode & 0o777)}",
        f"  modified {time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))}",
    ]
    if kind:
        lines.append(f"  type     {kind}")
    lines += _file_preview_lines(p,kind)
    return lines


def inspect_file(path):
    """Interactive file card: inspect first, act only on explicit keypress."""
    p=Path(path).expanduser().resolve()
    try:
        lines=_file_card_lines(p)
    except OSError as exc:
        print(f"LOOK · {p.name}\n  {_c('✗','31')} {exc}")
        return 1

    # Non-interactive output stays composable.
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("\n".join(lines))
        return 0

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    top=0
    try:
        tty.setcbreak(fd)
        while True:
            height=max(8,shutil.get_terminal_size((90,28)).lines)
            page_size=max(3,height-3)
            max_top=max(0,len(lines)-page_size)
            os.system("clear")
            visible=lines[top:top+page_size]
            print("\n".join(visible))
            if len(lines)>page_size:
                print(_c(f"{min(top+page_size,len(lines))}/{len(lines)} · j/k ↑/↓ · Space/b page", "2"))
            print(
                f"{_c('Enter','36')} open  {_c('E','36')} edit  {_c('Y','36')} copy path  "
                f"{_c('P','36')} print path  {_c('M','36')} move  {_c('C','36')} copy  "
                f"{_c('S','36')} send  {_c('R','31')} remove  {_c('q','2')} quit"
            )
            sys.stdout.flush()

            ch=os.read(fd,1)
            key=ch.decode("utf-8","ignore")
            if ch==b"\x1b":
                seq=bytearray(ch)
                while len(seq)<6:
                    ready,_,_=select.select([fd],[],[],0.08)
                    if not ready: break
                    seq.extend(os.read(fd,1))
                    if seq[-1:] in b"~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz": break
                key={b"\x1b[A":"up",b"\x1b[B":"down",b"\x1b[5~":"pageup",b"\x1b[6~":"pagedown"}.get(bytes(seq),"esc")

            if key in {"q","esc"}: break
            if key in {"j","down"}: top=min(max_top,top+1); continue
            if key in {"k","up"}: top=max(0,top-1); continue
            if key in {" ","pagedown"}: top=min(max_top,top+page_size); continue
            if key in {"b","pageup"}: top=max(0,top-page_size); continue

            # Restore cooked mode while an external app/prompt owns the terminal.
            termios.tcsetattr(fd,termios.TCSADRAIN,old)
            if key in {"\r","\n"}: _open_file(p)
            elif key=="E": _edit_file(p)
            elif key=="B":
                print("copied file to clipboard" if _copy_file_clipboard(p) else "file clipboard unavailable")
                input("press Enter › ")
            elif key=="Y":
                print("copied" if _copy_path(p) else str(p))
                input("press Enter › ")
            elif key=="P":
                print(str(p))
                return 0
            elif key=="M":
                _mutate_file(p,"move")
                if not p.exists(): return 0
            elif key=="C": _mutate_file(p,"copy")
            elif key=="S": _mutate_file(p,"send")
            elif key=="R":
                _mutate_file(p,"remove")
                if not p.exists(): return 0
            old=termios.tcgetattr(fd)
            tty.setcbreak(fd)
    finally:
        try: termios.tcsetattr(fd,termios.TCSADRAIN,old)
        except Exception: pass
    return 0

def inspect_anything(term):
    """Human-first classification for `lk <anything>`. Paths always win."""
    expanded=Path(term).expanduser()
    if expanded.exists():
        if expanded.is_dir(): return render([str(expanded)])
        return inspect_file(expanded)
    if term.isdigit():
        n=int(term)
        if 1 <= n <= 65535: return inspect_port(n)
    if shutil.which(term): return inspect_command(term)
    proc=inspect_process(term)
    if proc is not None: return proc
    print(f"LOOK · don't know how to inspect {_c(term, '1;36')}")
    print(f"  {_c('hint','33')} path · command · port · process, or try lk help")
    return 1


def main():
    # `lk o` remains the chat verb. In v2, bare `lk ollama` is inspection;
    # adding search/a prompt keeps the historical long-form chat spelling useful.
    if len(sys.argv) >= 2 and (
        sys.argv[1] == "o"
        or (
            sys.argv[1] == "ollama"
            and len(sys.argv) >= 3
            and sys.argv[2] not in {"models","test"}
        )
    ):
        args=sys.argv[2:]
        allow_start=True
        if args and args[0] == "--no-start":
            allow_start=False
            args=args[1:]
        force_search=bool(args and args[0] == "search")
        if force_search:
            args=args[1:]
        initial_prompt=" ".join(args).strip() or None
        return ollama_chat(force_search=force_search, initial_prompt=initial_prompt, allow_start=allow_start)
    a=sys.argv[1:]
    if not a: return render([])
    cmd=a[0]; rest=a[1:]
    if cmd=="_remember-worker": return _memory_worker()
    modes={"detail":"detail","dirs":"dirs","files":"files","tree":"tree","recent":"recent","size":"size"}
    if cmd in ("help","-h","--help"): return help_screen()
    if cmd in ("version","--version","-V"): print(f"LOOK {VERSION}"); return 0
    if cmd=="home": return home()
    if cmd=="undo": return _undo_last()
    if cmd=="_batch":
        if len(rest)<3: return 2
        kind=rest[0]
        if kind=="remove":
            paths=rest[2:] if rest[1]=="--" else rest[1:]
            return _batch_action(kind,"",paths)
        return _batch_action(kind,rest[1],rest[2:])
    if cmd=="_copy":
        if len(rest)!=2: return 2
        print(_action_result(_interactive_file_action("copy",rest[0],rest[1]))); return 0
    if cmd=="_move":
        if len(rest)!=2: return 2
        print(_action_result(_interactive_file_action("move",rest[0],rest[1]))); return 0
    if cmd=="_remove":
        if len(rest)!=1: return 2
        print(_action_result(_journal_remove(rest[0]))); return 0
    if cmd=="_mkdir":
        if len(rest)!=1: return 2
        print(_action_result(_journal_mkdir(rest[0]))); return 0
    if cmd=="doctor": return doctor()
    if cmd=="config":
        print(f"LOOK {VERSION}\n  executable  {Path(__file__).resolve()}\n  renderer    {RENDERER}\n  zshrc       {HOME/'.zshrc'}\n  secrets     {HOME/'.zsh_secrets'}\n  memory      {MEMORY_FILE}\n  memory queue {MEMORY_QUEUE}\n  undo        {UNDO_FILE}\n  ollama model {_preferred_ollama_model()}\n  ollama models {OLLAMA_MODELS_FILE}")
        return 0
    if cmd=="secrets":
        p=HOME/".zsh_secrets"
        if not p.exists(): print("LOOK secrets: ~/.zsh_secrets is not present."); return 1
        mode=oct(p.stat().st_mode & 0o777)
        print(f"LOOK secrets: {p} exists · permissions {mode} · contents hidden")
        return 0 if mode=="0o600" else 1
    if cmd in modes: return render(["--mode", modes[cmd], *rest])
    if cmd in {"run","project"}: return inspect_project(rest[0] if rest else '.')
    if cmd in {"up","ports","services"}: return inspect_up()
    if cmd=="port":
        if not rest or not rest[0].isdigit(): print("usage: lk port <number>"); return 2
        port=int(rest[0]); return inspect_port(port) if 1 <= port <= 65535 else 2
    if cmd in {"processes","procs"}: return inspect_processes()
    if cmd in {"process","proc"}:
        if not rest: print("usage: lk process <name>"); return 2
        query=" ".join(rest); result=inspect_process(query)
        if result is None:
            _title(query, 'process'); print(f"  {_c('·','33')} no matching process found"); return 1
        return result
    if cmd=="pid":
        if not rest or not rest[0].isdigit(): print("usage: lk pid <number>"); return 2
        return inspect_pid(int(rest[0]))
    if cmd=="git": return inspect_git(rest[0] if rest else '.')
    if cmd in {"machine","box"}: return inspect_machine()
    if cmd in {"net","network"}: return inspect_network()
    if cmd=="tailscale": return inspect_tailscale()
    if cmd=="ollama":
        if rest and rest[0]=="models":
            return ollama_models(rest[1] if len(rest)>1 else None)
        if rest and rest[0]=="test":
            return ollama_test(all_models=("--all" in rest[1:]))
        return inspect_ollama()
    if cmd=="env": return inspect_env()
    if cmd=="path": return inspect_path()
    if cmd=="gpu": return inspect_gpu()
    if cmd=="disk": return inspect_disk()
    if cmd=="why":
        if not rest: print("usage: lk why <command>"); return 2
        return inspect_command(rest[0])
    if len(a)==1: return inspect_anything(cmd)
    return render(a)
if __name__=="__main__": raise SystemExit(main())
