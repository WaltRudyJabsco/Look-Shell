    seen=set()
    for i,raw in enumerate(os.environ.get('PATH','').split(os.pathsep),1):
        p=Path(raw).expanduser()
        state=_c('✓','32') if p.is_dir() else _c('✗','31')
        dup=' '+_c('duplicate','33') if str(p) in seen else ''
        seen.add(str(p))
        print(f"  {i:>2} {state} {p}{dup}")
