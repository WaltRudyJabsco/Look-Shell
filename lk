def inspect_network():
    import socket
    local=[]
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ip=info[4][0]
            if not ip.startswith('127.') and ip not in local: local.append(ip)
    except OSError:
        pass
    rows=[("local",ip) for ip in local]
    if shutil.which('tailscale'):
        ip=_run_text(['tailscale','ip','-4'])
        if ip: rows.append(("tailnet",ip))
    if rows:
        return _select_values(f"network · {platform.node()}",rows)
    _title('network', platform.node())
    print("  local      unknown")
    print(f"  tailscale {_c('not installed','2')}" if not shutil.which('tailscale') else f"  tailscale {_c('no address','2')}")
    return 0

