def inspect_project(path='.'):
    """Recognize a project and show likely actions; never executes them."""
    d=Path(path).expanduser().resolve()
    _title('run', str(d))
    if not d.is_dir():
        print(f"  {_c('✗', '31')} not a directory")
        return 1
    actions=[]; kinds=[]
    def has(name): return (d/name).exists()
    if has('package.json'):
        kinds.append('Node/Bun')
        try:
            import json
            scripts=json.loads((d/'package.json').read_text()).get('scripts',{})
            runner='bun run' if has('bun.lock') or has('bun.lockb') else 'npm run'
            for key in ('dev','start','test','build','serve'):
                if key in scripts: actions.append((key,f'{runner} {key}'))
        except Exception: pass
    if has('pyproject.toml') or has('requirements.txt') or has('setup.py'):
        kinds.append('Python')
        if has('pytest.ini') or (d/'tests').exists(): actions.append(('test','python -m pytest'))
        if has('main.py'): actions.append(('start','python main.py'))
        elif has('app.py'): actions.append(('start','python app.py'))
    if has('Cargo.toml'):
        kinds.append('Rust'); actions += [('run','cargo run'),('test','cargo test'),('build','cargo build')]
    if has('Makefile'):
        kinds.append('Make'); actions.append(('targets','make -n <target>'))
    if has('docker-compose.yml') or has('compose.yml') or has('compose.yaml'):
        kinds.append('Docker Compose'); actions.append(('start','docker compose up'),('stop','docker compose down'))
    if has('Dockerfile'):
        kinds.append('Docker'); actions.append(('build','docker build .'))
    if has('index.html'):
        kinds.append('web'); actions.append(('serve','python3 -m http.server'))
    if has('.git'): kinds.append('Git')
    if not kinds:
        print(f"  {_c('·', '33')} no recognized project markers")
        return 1
    print(f"  type    {' + '.join(dict.fromkeys(kinds))}")
    if actions:
        print("  actions")
        seen=set()
        for label,cmd in actions:
            if cmd in seen: continue
            seen.add(cmd); print(f"    {_c(f'{label:<10}', '36')} {cmd}")
    else:
        print(f"  {_c('·', '33')} project recognized; no obvious standard action")
    return 0


