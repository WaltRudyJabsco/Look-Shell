def _run_filesystem_tool(workspace, name, args):
    try:
        if name == "list_files":
            return _tool_list_files(workspace, args.get("path", "."), args.get("depth", 1))
        if name == "read_file":
            return _tool_read_file(workspace, args.get("path", ""))
        if name == "search_files":
            return _tool_search_files(workspace, args.get("query", ""), args.get("path", "."))
        if name == "write_file":
            return _tool_write_file(workspace, args.get("path", ""), args.get("content", ""), bool(args.get("overwrite", False)))
        if name == "copy_path":
            return _tool_copy_path(workspace, args.get("source", ""), args.get("destination", ""))
        if name == "move_path":
            return _tool_move_path(workspace, args.get("source", ""), args.get("destination", ""))
        if name == "remove_path":
            return _tool_remove_path(workspace, args.get("path", ""), bool(args.get("confirmed", False)))
        if name == "make_directory":
            return _tool_make_directory(workspace, args.get("path", ""))
    except (OSError, ValueError) as exc:
        return f"File tool failed: {exc}"
    return f"Unknown file tool: {name}"

def _ollama_web_search(query):
    """Search via Ollama's hosted web API using the inherited API key."""
    import json
    import urllib.request

    key = os.environ.get("OLLAMA_API_KEY")
    if not key:
        raise RuntimeError("OLLAMA_API_KEY is not set")

    payload = json.dumps({"query": query}).encode()
    request = urllib.request.Request(
        "https://ollama.com/api/web_search",
        data=payload,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def _search_text(result):
    """Keep search context useful without flooding a local model's context."""
    import json

    results = result.get("results", [])[:5]
    compact = [
        {
            "title": item.get("title", ""),
            "url": item.get("url", ""),
            "content": item.get("content", "")[:1800],
        }
        for item in results
    ]
    return json.dumps(compact, ensure_ascii=False)


def _ansi_label(name, color):
    """Small semantic labels; standard ANSI colors respect terminal themes."""
    if not sys.stdout.isatty():
        return name
    return f"\033[{color}m\033[1m{name}\033[0m"


def _ollama_markup(text):
    """Render a restrained Markdown subset with terminal-native ANSI colors."""
    import re
    if not sys.stdout.isatty():
        return text

    reset="\033[0m"
    bold="\033[1m"
    italic="\033[3m"
    underline="\033[4m"
    cyan="\033[36m"
    magenta="\033[35m"
    yellow="\033[33m"
    green="\033[32m"
    blue="\033[34m"

    out=[]
    in_code=False
    for line in text.splitlines():
        if line.strip().startswith("```"):
            in_code=not in_code
            continue
        if in_code:
            out.append(green + line + reset)
            continue

        if line.startswith("# "):
            out.append(bold + cyan + line[2:] + reset)
            continue
        if line.startswith("## "):
            out.append(bold + magenta + line[3:] + reset)
            continue
        if line.startswith("### "):
            out.append(bold + yellow + line[4:] + reset)
            continue

        # Protect inline code while applying the other lightweight markup.
        code_spans=[]
        def hold_code(match):
            code_spans.append(match.group(1))
            return f"\x00CODE{len(code_spans)-1}\x00"
        line=re.sub(r'`([^`]+)`', hold_code, line)

        # Keep the real URL visible. Terminal URL detection is more portable
        # than hidden hyperlink metadata and remains easy to copy or right-click.
        def render_link(match):
            label, url = match.group(1), match.group(2)
            return label + " — " + blue + underline + url + reset

        line=re.sub(
            r'\[([^\]]+)\]\((https?://[^)]+)\)',
            render_link,
            line,
        )
        # Style literal URLs too, while leaving the URL itself intact.
        line=re.sub(
            r'(?<!\x1b]8;;)(?<!\()(?<!\w)(https?://[^\s<>]+)',
            lambda m: blue + underline + m.group(1) + reset,
            line,
        )
        line=re.sub(r'\*\*(.+?)\*\*', lambda m: bold+m.group(1)+reset, line)
        line=re.sub(r'(?<!\*)\*([^*\n]+)\*(?!\*)', lambda m: italic+m.group(1)+reset, line)
        line=re.sub(r'(?<!_)_([^_\n]+)_(?!_)', lambda m: italic+m.group(1)+reset, line)

        if line.startswith(('- ', '* ')):
            line=cyan+'•'+reset+' '+line[2:]

        for i, code in enumerate(code_spans):
            line=line.replace(f"\x00CODE{i}\x00", green+code+reset)
        out.append(line)
    return "\n".join(out)


def _ollama_ps(base, timeout=2):
    import json
    import urllib.request
    with urllib.request.urlopen(base + "/api/ps", timeout=timeout) as response:
        return json.load(response).get("models", [])


def _local_ollama_host(base):
    from urllib.parse import urlparse
    host = (urlparse(base).hostname or "").lower()
    return host in {"127.0.0.1", "localhost", "::1"}


def _ensure_ollama_server(base, allow_start=True):
    """Return running models; start a missing local Ollama server only on explicit LO use."""
    try:
        return _ollama_ps(base)
    except Exception:
        pass

    ollama = shutil.which("ollama")
    if not allow_start or not ollama or not _local_ollama_host(base):
        return None

    try:
        with _activity("starting Ollama"):
            subprocess.Popen(
                [ollama, "serve"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            deadline = time.monotonic() + 6.0
            while time.monotonic() < deadline:
                try:
                    return _ollama_ps(base, timeout=0.6)
                except Exception:
                    time.sleep(0.2)
    except OSError:
        return None
    return None


def _preferred_ollama_model():
    """Environment wins; otherwise remember the last model selected through LOOK."""
    env=os.environ.get("LOOK_OLLAMA_MODEL","").strip()
    if env:
        return env
    try:
        saved=OLLAMA_MODEL_FILE.read_text(encoding="utf-8").strip()
        if saved:
            return saved
    except OSError:
        pass
    return "qwen3:8b"


def _save_preferred_ollama_model(model):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp=OLLAMA_MODEL_FILE.with_suffix(".tmp")
        tmp.write_text(model.strip()+"\n", encoding="utf-8")
        os.chmod(tmp,0o600)
        tmp.replace(OLLAMA_MODEL_FILE)
        os.chmod(OLLAMA_MODEL_FILE,0o600)
    except OSError:
        pass


def _choose_ollama_model(running):
    """Keep the selected/resident model when available; otherwise load the preferred model on demand."""
    preferred=_preferred_ollama_model()
    names=[(m.get("name") or m.get("model") or "").strip() for m in (running or [])]
    names=[name for name in names if name]
    if preferred in names:
        return preferred, True
    if names:
        return names[0], True
    return preferred, False


def ollama_chat(force_search=False, initial_prompt=None, allow_start=True):
    """Minimal local chat; optional first prompt and web-search mode."""
    import json
    import urllib.request

    base = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")

    running = _ensure_ollama_server(base, allow_start=allow_start)
    if running is None:
        print("LOOK OLLAMA · server unavailable")
        return 1

    model, resident = _choose_ollama_model(running)

    has_web = bool(os.environ.get("OLLAMA_API_KEY"))
    mode = "LOOK OLLAMA SEARCH" if force_search else "LOOK OLLAMA"
    web_state = "required" if force_search else ("available" if has_web else "off")
    print(f"{mode} · {model} · {Path.cwd()}")
    if not resident:
        print(f"model · idle · loads on first prompt")
    print(f"web · {web_state} · Ctrl-D to exit\n")

    web_tool = {
        "type": "function",
        "function": {
            "name": "web_search",
            "description": "Search the web for current or externally verifiable information. Use this when the answer depends on recent events, news, current facts, or information you are uncertain about.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "The web search query"}
                },
                "required": ["query"],
            },
        },
    }

    workspace = Path.cwd().resolve()
    memory = _load_memory()
    messages = [
        {"role": "system", "content": _workspace_snapshot(workspace)},
        {"role": "system", "content": (
            "You are LOOK Ollama, running inside the user's LOOK Shell terminal interface. "
            "Keep answers concise and terminal-readable. Use lightweight Markdown naturally when it improves clarity: "
            "# / ## / ### headings, **bold**, *italics*, bullets, inline code, fenced code blocks, and Markdown links. "
            "LOOK renders these with terminal styling, and http/https Markdown links may be clickable in supporting terminals. "
            "Do not over-format simple answers. "
            "When the user refers to 'this folder', 'here', local files, or the current project, "
            "use the workspace context and file tools instead of guessing. "
            "You may list files, read bounded text files, search filenames/text, create or intentionally modify UTF-8 text, "
            "and use bounded copy_path, move_path, remove_path, and make_directory tools inside the workspace. "
            "When the user asks to copy, duplicate, clone, or back up an existing path, ALWAYS use copy_path; never reconstruct it with read_file + write_file. "
            "When the user asks to move or rename an existing path, use move_path. When explicitly asked to remove one, use remove_path. "
            "Use write_file only for intentional textual creation or editing. Only mutate files when the user explicitly asks. "
            "Do not claim to have read or changed a file unless the corresponding tool supplied or confirmed it. "
            "Do not claim filesystem access outside the starting LOOK workspace. "
            "If web_search is available, use it when current or externally verifiable information is needed; "
            "when citing or recommending web material, always preserve the exact http/https URL supplied by the search result and emit a complete Markdown link in the form [descriptive label](https://actual-url). Never emit citation placeholders such as [source], [1], or a site name styled like a link without an actual URL. Never invent a URL from a site name."
        )},
    ]
    memory_context = _memory_context(memory)
    if memory_context:
        messages.append({"role": "system", "content": memory_context})

    pending_prompt = (initial_prompt or "").strip()
    while True:
        if pending_prompt:
            prompt=pending_prompt
            pending_prompt=""
            print(f"{_ansi_label('you ›', '36')} {prompt}")
        else:
            try:
                prompt = input(_ansi_label("you ›", "36") + " ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return 0

        if not prompt:
            continue

        messages.append({"role": "user", "content": prompt})

        # Search mode is deliberately deterministic: search first, then answer.
        if force_search:
            if not has_web:
                print("search › OLLAMA_API_KEY is not set\n")
                messages.pop()
                continue
            try:
                print(f"{_ansi_label('search ›', '33')} {prompt}")
                with _activity("searching"):
                    result = _ollama_web_search(prompt)
                messages.append({
                    "role": "system",
                    "content": "Current web search results for the user's latest question:\n" + _search_text(result) +
                               "\nUse these results when answering. When citing or recommending any result, preserve the exact URL from the result and emit a complete Markdown link in the form [descriptive label](https://actual-url). Never emit [source], [1], or a site name as a pseudo-link without an actual URL, and never invent a URL.",
                })
            except Exception as exc:
                print(f"search › {exc}\n")
                messages.pop()
                continue

        # Normal mode exposes search as a tool. Tool-capable models decide when to use it.
        for _ in range(4):
            payload_obj = {
                "model": model,
                "messages": messages,
                "stream": False,
            }
            tools = _filesystem_tools()
            if has_web and not force_search:
                tools.append(web_tool)
            payload_obj["tools"] = tools

            payload = json.dumps(payload_obj).encode()
            request = urllib.request.Request(
                base + "/api/chat",
                data=payload,
                headers={"Content-Type": "application/json"},
                method="POST",
            )

            try:
                with _activity("thinking"):
                    with urllib.request.urlopen(request) as response:
                        result = json.load(response)
            except Exception as exc:
                print(f"LOOK OLLAMA · {exc}")
                messages.pop()
                break

            message = result.get("message", {})
            tool_calls = message.get("tool_calls") or []
            if tool_calls:
                messages.append(message)
                for call in tool_calls:
                    function = call.get("function", {})
                    name = function.get("name", "")
                    args = function.get("arguments", {}) or {}
                    if isinstance(args, str):
                        try:
                            args=json.loads(args)
                        except Exception:
                            args={}

                    if name == "web_search":
                        if not has_web or force_search:
                            tool_content = "Web search is unavailable in this session."
                        else:
                            query = args.get("query", prompt)
                            try:
                                print(f"{_ansi_label('search ›', '33')} {query}")
                                with _activity("searching"):
                                    search_result = _ollama_web_search(query)
                                tool_content = _search_text(search_result)
                            except Exception as exc:
                                tool_content = f"Web search failed: {exc}"
                    elif name in {"list_files", "read_file", "search_files", "write_file", "copy_path", "move_path", "remove_path", "make_directory"}:
                        tool_content = _run_filesystem_tool(workspace, name, args)
                        if name in {"write_file", "copy_path", "move_path", "remove_path", "make_directory"}:
                            print(f"{_ansi_label('file ›', '32')} {tool_content}")
                    else:
                        tool_content = f"Unknown tool: {name}"

                    messages.append({
                        "role": "tool",
                        "tool_name": name,
                        "content": tool_content,
                    })
                continue

            answer = message.get("content", "").strip()
            messages.append({"role": "assistant", "content": answer})
            print("\n" + _ansi_label("lo ›", "35") + " " + _ollama_markup(answer) + "\n")
            if _queue_memory_exchange(base, model, prompt, answer):
                if sys.stdout.isatty():
                    print(_c("  · remembering in background", "2"))
            else:
                # If queueing ever fails, preserve memory rather than silently dropping it.
                with _activity("remembering"):
                    memory = _remember_exchange(base, model, memory, prompt, answer)
            break


def _c(text, code):
    """Semantic terminal color with a truecolor LOOK 3 presentation path."""
    if not sys.stdout.isatty():
        return str(text)

    classic=os.environ.get("LOOK_CLASSIC","").lower() in {"1","true","yes","on"}
    truecolor=(not classic and (
        os.environ.get("COLORTERM","").lower() in {"truecolor","24bit"}
        or os.environ.get("TERM_PROGRAM") in {"iTerm.app","Apple_Terminal","WezTerm","ghostty"}
    ))
    if not truecolor:
        return f"\033[{code}m{text}\033[0m"

    rgb={
        "36":(103,214,238), "1;36":(103,214,238),
        "32":(139,214,145), "1;32":(139,214,145),
        "33":(238,200,109),
        "31":(239,125,135),
    }
    if code=="2":
        return f"\033[38;2;128;139;154m{text}\033[0m"
    if code=="1":
        return f"\033[1m{text}\033[0m"
    color=rgb.get(code)
    if color:
        bold="\033[1m" if code.startswith("1;") else ""
        r,g,b=color
        return f"{bold}\033[38;2;{r};{g};{b}m{text}\033[0m"
    return f"\033[{code}m{text}\033[0m"


def _title(name, detail=''):
    tail=f"  {_c('· '+detail, '2')}" if detail else ''
    print(f"{_c(name, '1;36')}{tail}")


def _run_text(args, timeout=1.5):
    try:
        r=subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ''
    except (OSError, subprocess.SubprocessError):
        return ''


def inspect_command(name):
    """Explain how a command resolves without changing the shell."""
    path=shutil.which(name)
    _title(name, 'command')
    if not path:
        print(f"  {_c('✗', '31')} not found on PATH")
        # zsh can know about aliases/functions that a child Python process cannot inspect directly.
        print(f"  {_c('hint', '33')} run: type -a {name}")
        return 1
    real=str(Path(path).resolve())
    print(f"  {_c('✓', '32')} executable  {path}")
    if real != path:
        print(f"  {_c('↗', '36')} resolves     {real}")
    try:
        st=Path(path).stat()
        mode=oct(st.st_mode & 0o777)
        print(f"  permissions {mode}")
    except OSError:
        pass
    matches=[]
    for folder in os.environ.get('PATH','').split(os.pathsep):
        candidate=Path(folder).expanduser()/name
        if candidate.exists() and os.access(candidate, os.X_OK):
            val=str(candidate)
            if val not in matches: matches.append(val)
    if len(matches)>1:
        print("  alternatives")
        for m in matches[:8]: print(f"    · {m}")
    return 0


