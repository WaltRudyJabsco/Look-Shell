def inspect_disk():
    _title('disk')
    seen=set()
    for label,path in [('cwd',Path.cwd()),('home',HOME)]:
        try:
            usage=shutil.disk_usage(path)
        except OSError:
            continue
        key=(usage.total,usage.free)
        if key in seen: continue
        seen.add(key)
        used=usage.total-usage.free
        pct=(used/usage.total*100) if usage.total else 0
        print(f"  {label:<5} {path}")
        print(f"        {used/(1024**3):.0f} GB used · {usage.free/(1024**3):.0f} GB free · {usage.total/(1024**3):.0f} GB total · {pct:.0f}%")
    return 0


def inspect_process(term):
    """Best-effort process-name lookup for lk <anything>."""
    text=_run_text(['ps','-axo','pid=,command='],2)
    hits=[]
    for line in text.splitlines():
        stripped=line.strip()
        if term.lower() not in stripped.lower():
            continue
        first=stripped.split(None,1)[0] if stripped else ''
        if first.isdigit() and int(first)==os.getpid():
            continue
        hits.append(stripped)
    if not hits: return None
    _title(term, 'process')
    for line in hits[:15]: print(f"  {line}")
    if len(hits)>15: print(f"  {_c('…', '2')} {len(hits)-15} more")
    return 0


def inspect_file(path):
    p=Path(path).expanduser().resolve()
    _title(p.name, 'file')
    try:
        st=p.stat()
        size=st.st_size
        if size < 1024: shown=f"{size} B"
        elif size < 1024**2: shown=f"{size/1024:.1f} KB"
        elif size < 1024**3: shown=f"{size/1024**2:.1f} MB"
        else: shown=f"{size/1024**3:.1f} GB"
        print(f"  path    {p}")
        print(f"  size    {shown}")
        print(f"  mode    {oct(st.st_mode & 0o777)}")
        print(f"  modified {time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))}")
    except OSError as exc:
        print(f"  {_c('✗','31')} {exc}"); return 1
    kind=_run_text(['file','-b',str(p)]) if shutil.which('file') else ''
    if kind: print(f"  type    {kind}")
    return 0


def inspect_anything(term):
    """Human-first classification for `lk <anything>`. Paths always win."""
    expanded=Path(term).expanduser()
    if expanded.exists():
        if expanded.is_dir(): return render([str(expanded)])
        return inspect_file(expanded)
    if term.isdigit():
        n=int(term)
        if 1 <= n <= 65535: return inspect_port(n)
    if shutil.which(term): return inspect_command(term)
    proc=inspect_process(term)
    if proc is not None: return proc
    print(f"LOOK · don't know how to inspect {_c(term, '1;36')}")
    print(f"  {_c('hint','33')} path · command · port · process, or try lk help")
    return 1


def main():
    # `lk o` remains the chat verb. In v2, bare `lk ollama` is inspection;
    # adding search/a prompt keeps the historical long-form chat spelling useful.
    if len(sys.argv) >= 2 and (
        sys.argv[1] == "o" or (sys.argv[1] == "ollama" and len(sys.argv) >= 3)
    ):
        args=sys.argv[2:]
        allow_start=True
        if args and args[0] == "--no-start":
            allow_start=False
            args=args[1:]
        force_search=bool(args and args[0] == "search")
        if force_search:
            args=args[1:]
        initial_prompt=" ".join(args).strip() or None
        return ollama_chat(force_search=force_search, initial_prompt=initial_prompt, allow_start=allow_start)
    a=sys.argv[1:]
    if not a: return render([])
    cmd=a[0]; rest=a[1:]
    modes={"detail":"detail","dirs":"dirs","files":"files","tree":"tree","recent":"recent","size":"size"}
    if cmd in ("help","-h","--help"): return help_screen()
    if cmd in ("version","--version","-V"): print(f"LOOK {VERSION}"); return 0
    if cmd=="home": return home()
    if cmd=="doctor": return doctor()
    if cmd=="config":
        print(f"LOOK {VERSION}\n  executable  {Path(__file__).resolve()}\n  renderer    {RENDERER}\n  zshrc       {HOME/'.zshrc'}\n  secrets     {HOME/'.zsh_secrets'}\n  memory      {MEMORY_FILE}\n  ollama model {os.environ.get('LOOK_OLLAMA_MODEL', 'qwen3:8b')}")
        return 0
    if cmd=="secrets":
        p=HOME/".zsh_secrets"
        if not p.exists(): print("LOOK secrets: ~/.zsh_secrets is not present."); return 1
        mode=oct(p.stat().st_mode & 0o777)
        print(f"LOOK secrets: {p} exists · permissions {mode} · contents hidden")
        return 0 if mode=="0o600" else 1
    if cmd in modes: return render(["--mode", modes[cmd], *rest])
    if cmd in {"run","project"}: return inspect_project(rest[0] if rest else '.')
    if cmd in {"up","ports","services"}: return inspect_up()
    if cmd=="port":
        if not rest or not rest[0].isdigit(): print("usage: lk port <number>"); return 2
        port=int(rest[0]); return inspect_port(port) if 1 <= port <= 65535 else 2
    if cmd in {"process","proc"}:
        if not rest: print("usage: lk process <name>"); return 2
        query=" ".join(rest); result=inspect_process(query)
        if result is None:
            _title(query, 'process'); print(f"  {_c('·','33')} no matching process found"); return 1
        return result
    if cmd=="pid":
        if not rest or not rest[0].isdigit(): print("usage: lk pid <number>"); return 2
        return inspect_pid(int(rest[0]))
    if cmd=="git": return inspect_git(rest[0] if rest else '.')
    if cmd in {"machine","box"}: return inspect_machine()
    if cmd in {"net","network"}: return inspect_network()
    if cmd=="tailscale": return inspect_tailscale()
    if cmd=="ollama": return inspect_ollama()
    if cmd=="env": return inspect_env()
    if cmd=="path": return inspect_path()
    if cmd=="gpu": return inspect_gpu()
    if cmd=="disk": return inspect_disk()
    if cmd=="why":
        if not rest: print("usage: lk why <command>"); return 2
        return inspect_command(rest[0])
    if len(a)==1: return inspect_anything(cmd)
    return render(a)
if __name__=="__main__": raise SystemExit(main())
