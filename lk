def home():
    """Paint the LOOK 3 landing screen, then immediately return to the shell."""
    import urllib.request

    tty_out = sys.stdout.isatty()
    if tty_out:
        sys.stdout.write("\033[2J\033[H")

    cwd=Path.cwd()
    try:
        shown='~/' + str(cwd.relative_to(HOME)) if cwd != HOME else '~'
    except ValueError:
        shown=str(cwd)

    branch=''
    dirty=False
    try:
        result=subprocess.run(
            ['git','branch','--show-current'], cwd=cwd,
            capture_output=True, text=True, timeout=0.5
        )
        if result.returncode == 0:
            branch=result.stdout.strip()
        status=subprocess.run(
            ['git','status','--porcelain'], cwd=cwd,
            capture_output=True, text=True, timeout=0.5
        )
        dirty=(status.returncode==0 and bool(status.stdout.strip()))
    except (OSError, subprocess.SubprocessError):
        pass

    base=os.environ.get('OLLAMA_HOST','http://127.0.0.1:11434').rstrip('/')
    ollama='offline'
    ollama_live=False
    try:
        with urllib.request.urlopen(base + '/api/ps', timeout=0.45) as response:
            import json
            models=json.load(response).get('models',[])
        if models:
            name=models[0].get('name') or models[0].get('model') or 'ready'
            ollama=name
            ollama_live=True
        else:
            ollama='ready · idle'
    except Exception:
        if shutil.which('ollama'):
            ollama='available · idle'

    print(_c(f"LOOK {VERSION}", "1;36"))
    git_tail=''
    if branch:
        git_state=_c("●", "33" if dirty else "32")
        git_tail=f"  {_c('git','2')} {branch} {git_state}"
    print(f"{_c('◆','36')} {_c(shown,'1')}{git_tail}")
    lo_state=_c("●","32") if ollama_live else _c("○","2")
    print(f"{_c('lo','1;36')} {lo_state} {_c(ollama,'2')}")
    print(_c("─"*min(62, max(28, len(shown)+16)), "2"))
    print()

    fortune=shutil.which('fortune')
    cowsay=shutil.which('cowsay')
    if fortune and cowsay:
        try:
            quote=subprocess.run([fortune], capture_output=True, text=True, timeout=1).stdout
            cow=subprocess.run([cowsay,'-r'], input=quote, capture_output=True, text=True, timeout=1).stdout
            if cow.strip():
                print(cow.rstrip())
                print()
        except (OSError, subprocess.SubprocessError):
            pass

    print(_c("What file do you want? What question do you have?", "2"))
    print(f"{_c('l','36')} look around   {_c('lo','36')} ask   {_c('lk','36')} inspect   {_c('lh','36')} home")
    return 0

def _doctor_body():
    import json
    import urllib.request

    tools=["zsh","python3","git","zoxide","fzf","nvim","bat","fortune","cowsay"]
    checks=[(x,shutil.which(x) is not None) for x in tools]
    checks.append(("neofetch/fastfetch", bool(shutil.which("neofetch") or shutil.which("fastfetch"))))
    files=[("~/.zshrc",(HOME/".zshrc").exists()),
           ("~/.zsh_secrets",(HOME/".zsh_secrets").exists()),
           ("LOOK renderer",RENDERER.exists())]

    base = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
    ollama_bin = shutil.which("ollama") is not None
    server = False
    loaded = []
    try:
        with urllib.request.urlopen(base + "/api/ps", timeout=1.5) as response:
            loaded = json.load(response).get("models", [])
            server = True
    except Exception:
        pass

    memory_ok = _ensure_memory_file()
    web_key = bool(os.environ.get("OLLAMA_API_KEY"))

    print(f"LOOK {VERSION}\n"+"─"*46)
    print(f"\nSYSTEM\n  {platform.system()} {platform.release()} · {platform.machine()}")
    print("\nTOOLS")
    for n,ok in checks: print(f"  {'✓' if ok else '✗'} {n}")
    print("\nSHELL")
    for n,ok in files: print(f"  {'✓' if ok else '✗'} {n}")

    print("\nOLLAMA · optional")
    print(f"  {'✓' if ollama_bin else '·'} binary")
    print(f"  {'✓' if server else '·'} server")
    if server:
        if loaded:
            names = ", ".join((m.get("name") or m.get("model") or "?") for m in loaded)
            print(f"  ✓ model loaded · {names}")
        else:
            preferred = os.environ.get("LOOK_OLLAMA_MODEL", "qwen3:8b").strip() or "qwen3:8b"
            print(f"  · no model loaded · lo uses {preferred} on demand")
    else:
        print("  · model status unavailable")
    print(f"  {'✓' if web_key else '·'} web search key")
    print(f"  {'✓' if memory_ok else '✗'} persistent memory")

    print("\nPREVIEW · optional")
    image_preview=bool(shutil.which("chafa"))
    pdf_preview=image_preview and bool(shutil.which("pdftoppm") or (platform.system()=="Darwin" and shutil.which("qlmanage")))
    print(f"  {'✓' if image_preview else '·'} image preview" + ("" if image_preview else " · install chafa to enable"))
    print(f"  {'✓' if pdf_preview else '·'} PDF image preview" + ("" if pdf_preview else " · needs image preview + PDF rasterizer"))

    good=all(ok for _,ok in checks+files) and memory_ok
    print("\n"+("Everything looks good." if good else "LOOK found something worth checking."))
    return 0 if good else 1


def doctor():
    import io, contextlib
    buf=io.StringIO()
    with contextlib.redirect_stdout(buf):
        code=_doctor_body()
    _page_text(buf.getvalue())
    return code


def _empty_memory():
    return {"long": "", "recent": []}


def _ensure_memory_file():
    import json
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if not MEMORY_FILE.exists():
            MEMORY_FILE.write_text(json.dumps(_empty_memory(), indent=2) + "\n")
            os.chmod(MEMORY_FILE, 0o600)
        return True
    except OSError:
        return False


def _load_memory():
    import json
    if not _ensure_memory_file():
        return _empty_memory()
    try:
        data=json.loads(MEMORY_FILE.read_text())
        recent=data.get("recent", [])
        return {
            "long": str(data.get("long", ""))[:3000],
            "recent": [str(x)[:900] for x in recent[-RECENT_MEMORY_SLOTS:]],
        }
    except Exception:
        return _empty_memory()


def _save_memory(memory):
    import json
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp=MEMORY_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(memory, ensure_ascii=False, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        tmp.replace(MEMORY_FILE)
        os.chmod(MEMORY_FILE, 0o600)
    except OSError:
        pass


def _memory_context(memory):
    parts=[]
    if memory.get("long"):
        parts.append("Long memory:\n" + memory["long"])
    if memory.get("recent"):
        recent="\n".join(f"{i+1}. {note}" for i,note in enumerate(memory["recent"]))
        parts.append("Recent memory, oldest to newest:\n" + recent)
    if not parts:
        return ""
    return (
        "Persistent context from previous LOOK Ollama conversations follows. "
        "Use it only when relevant; newer conversation content wins if there is a conflict.\n\n"
        + "\n\n".join(parts)
    )


def _local_chat_once(base, model, messages):
    import json
    import urllib.request
    payload=json.dumps({"model": model, "messages": messages, "stream": False}).encode()
    request=urllib.request.Request(
        base + "/api/chat", data=payload,
        headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(request) as response:
        result=json.load(response)
    return result.get("message", {}).get("content", "").strip()



@contextmanager
def _activity(label):
    """Show a small animated status while a synchronous Ollama step is busy."""
    interactive = sys.stdout.isatty()
    if not interactive:
        print(f"· {label}", flush=True)
        yield
        return

    stop = threading.Event()
    frames = ("◐", "◓", "◑", "◒")

    def animate():
        i = 0
        while not stop.is_set():
            frame=_c(frames[i % len(frames)], "36")
            sys.stdout.write(f"\r\033[2K{frame} {_c(label,'2')}")
            sys.stdout.flush()
            i += 1
            stop.wait(0.12)

    worker = threading.Thread(target=animate, daemon=True)
    worker.start()
    try:
        yield
    finally:
        stop.set()
        worker.join(timeout=0.5)
        sys.stdout.write("\r\033[2K")
        sys.stdout.flush()

def _compress_exchange(base, model, user_text, assistant_text):
    prompt = f'''Compress this conversation exchange into one durable memory note, maximum 90 words.
Keep concrete preferences, decisions, project state, names, commands, or unresolved tasks that may matter later.
Drop pleasantries and disposable details. Do not invent anything.

USER:
{user_text[:4000]}

ASSISTANT:
{assistant_text[:5000]}'''
    try:
        return _local_chat_once(base, model, [
            {"role":"system","content":"You maintain concise persistent memory for a terminal assistant."},
            {"role":"user","content":prompt},
        ])[:900]
    except Exception:
        return ("User: " + user_text[:350] + " | Assistant: " + assistant_text[:450])[:900]


def _fold_long_memory(base, model, old_long, evicted_note):
    prompt = f'''Rewrite the long-term memory below so it incorporates the newly archived recent note.
Maximum 260 words. Preserve durable facts, preferences, decisions, active project state, and unresolved tasks.
Prefer newer information if it supersedes older information. Remove redundancy. Do not invent anything.

CURRENT LONG MEMORY:
{old_long or "(empty)"}

NEW ARCHIVED NOTE:
{evicted_note}'''
    try:
        return _local_chat_once(base, model, [
            {"role":"system","content":"You maintain a compact rolling long-term memory."},
            {"role":"user","content":prompt},
        ])[:3000]
    except Exception:
        combined=(old_long + "\n" + evicted_note).strip()
        return combined[-3000:]


def _remember_exchange(base, model, memory, user_text, assistant_text):
    note=_compress_exchange(base, model, user_text, assistant_text)
    recent=list(memory.get("recent", []))
    recent.append(note)
    long_memory=memory.get("long", "")
    if len(recent) > RECENT_MEMORY_SLOTS:
        evicted=recent.pop(0)
        long_memory=_fold_long_memory(base, model, long_memory, evicted)
    updated={"long": long_memory, "recent": recent}
    _save_memory(updated)
    return updated


def _memory_job_files():
    try:
        return sorted(MEMORY_QUEUE.glob("*.json"))
    except OSError:
        return []


def _memory_worker_active():
    try:
        pid=int(MEMORY_WORKER_LOCK.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        try:
            MEMORY_WORKER_LOCK.unlink()
        except OSError:
            pass
        return False


def _start_memory_worker():
    """Start one detached memory worker; duplicate launches exit harmlessly."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_remember-worker"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError:
        pass


def _queue_memory_exchange(base, model, user_text, assistant_text):
    """Durably enqueue an exchange, then let detached housekeeping own compression."""
    try:
        MEMORY_QUEUE.mkdir(parents=True, exist_ok=True)
        token=f"{time.time_ns()}-{uuid.uuid4().hex[:8]}"
        tmp=MEMORY_QUEUE/(token+".tmp")
        job=MEMORY_QUEUE/(token+".json")
        payload={
            "base":base,
            "model":model,
            "user":user_text[:12000],
            "assistant":assistant_text[:16000],
        }
        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(job)
        os.chmod(job, 0o600)
        _start_memory_worker()
        return True
    except OSError:
        return False


def _memory_worker():
    """Drain queued memory jobs serially, then exit. Safe across lo sessions."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    # Atomic lock creation gives us one worker without a daemon or dependency.
    try:
        fd=os.open(MEMORY_WORKER_LOCK, os.O_CREAT|os.O_EXCL|os.O_WRONLY, 0o600)
    except FileExistsError:
        return 0
    try:
        os.write(fd, str(os.getpid()).encode())
    finally:
        os.close(fd)

    try:
        while True:
            jobs=_memory_job_files()
            if not jobs:
                break

            job_path=jobs[0]
            try:
                job=json.loads(job_path.read_text(encoding="utf-8"))
                memory=_load_memory()
                _remember_exchange(
                    job.get("base","http://127.0.0.1:11434"),
                    job.get("model",os.environ.get("LOOK_OLLAMA_MODEL","qwen3:8b")),
                    memory,
                    str(job.get("user","")),
                    str(job.get("assistant","")),
                )
                job_path.unlink()
            except Exception:
                # Leave the job for a future worker rather than losing memory.
                break
    finally:
        try:
            MEMORY_WORKER_LOCK.unlink()
        except OSError:
            pass

    # Close the tiny shutdown race: if a job arrived while we released the lock,
    # launch one fresh worker to pick it up.
    if _memory_job_files():
        _start_memory_worker()
    return 0



def _safe_workspace_path(workspace, raw_path="."):
    """Resolve a path while keeping Ollama file tools inside the starting cwd."""
    workspace = Path(workspace).resolve()
    raw_path = raw_path or "."
    candidate = Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate = workspace / candidate
    candidate = candidate.resolve()
    try:
        candidate.relative_to(workspace)
    except ValueError:
        raise ValueError("path is outside the LOOK Ollama workspace")
    return candidate


def _workspace_snapshot(workspace):
    """Small guaranteed folder context; deeper inspection is handled by tools."""
    workspace = Path(workspace).resolve()
    try:
        entries = sorted(workspace.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))[:120]
    except OSError as exc:
        return f"Current workspace: {workspace}\nDirectory listing unavailable: {exc}"
    shown=[]
    for item in entries:
        try:
            suffix="/" if item.is_dir() else ""
        except OSError:
            suffix=""
        shown.append(item.name + suffix)
    more="\n…listing truncated" if len(entries) == 120 else ""
    return (
        f"Current workspace: {workspace}\n"
        "Treat this as the user's current folder. File tools are restricted to this folder and its descendants.\n"
        "Top-level contents:\n" + ("\n".join(shown) if shown else "(empty)") + more
    )


def _tool_list_files(workspace, path=".", depth=1):
    target=_safe_workspace_path(workspace, path)
    if not target.exists():
        return f"Not found: {path}"
    if not target.is_dir():
        return f"Not a directory: {path}"
    depth=max(1, min(int(depth or 1), 3))
    lines=[]
    def walk(folder, level):
        if level > depth or len(lines) >= 250:
            return
        try:
            children=sorted(folder.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
        except (OSError, PermissionError):
            return
        for child in children:
            if len(lines) >= 250:
                return
            rel=child.relative_to(workspace)
            try:
                is_dir=child.is_dir()
            except OSError:
                is_dir=False
            lines.append(str(rel) + ("/" if is_dir else ""))
            if is_dir:
                walk(child, level+1)
    walk(target, 1)
    return "\n".join(lines) if lines else "(empty or unreadable)"


def _tool_read_file(workspace, path):
    target=_safe_workspace_path(workspace, path)
    if not target.exists():
        return f"Not found: {path}"
    if not target.is_file():
        return f"Not a file: {path}"
    try:
        if target.stat().st_size > 1_000_000:
            return "File is larger than the 1 MB read limit."
        data=target.read_bytes()
        if b"\x00" in data[:4096]:
            return "Binary file; text preview unavailable."
        text=data.decode("utf-8", errors="replace")
        return text[:16000] + ("\n…truncated" if len(text) > 16000 else "")
    except OSError as exc:
        return f"Read failed: {exc}"


def _tool_search_files(workspace, query, path="."):
    target=_safe_workspace_path(workspace, path)
    if not target.exists() or not target.is_dir():
        return f"Not a directory: {path}"
    needle=(query or "").lower()
    if not needle:
        return "Search query is empty."
    matches=[]
    scanned=0
    for root, dirs, files in os.walk(target):
        rootp=Path(root)
        try:
            rel_depth=len(rootp.relative_to(target).parts)
        except ValueError:
            continue
        dirs[:] = [d for d in dirs if not d.startswith('.') and rel_depth < 4]
        for name in dirs + files:
            rel=(rootp / name).relative_to(workspace)
            if needle in name.lower():
                matches.append(str(rel) + ("/" if name in dirs else ""))
                if len(matches) >= 100:
                    return "\n".join(matches)
        for name in files:
            if scanned >= 500 or len(matches) >= 100:
                break
            scanned += 1
            filep=rootp / name
            try:
                if filep.stat().st_size > 300_000:
                    continue
                data=filep.read_bytes()
                if b"\x00" in data[:4096]:
                    continue
                text=data.decode("utf-8", errors="ignore")
            except OSError:
                continue
            if needle in text.lower():
                rel=filep.relative_to(workspace)
                if str(rel) not in matches:
                    matches.append(str(rel))
        if scanned >= 500 or len(matches) >= 100:
            break
    return "\n".join(matches) if matches else "No matches."


def _tool_write_file(workspace, path, content, overwrite=False):
    target=_safe_workspace_path(workspace, path)
    if target.exists() and not overwrite:
        return f"Refusing to overwrite existing file: {path}. Set overwrite=true only when the user explicitly asked to replace it."
    if not target.parent.exists() or not target.parent.is_dir():
        return f"Parent directory does not exist: {target.parent.relative_to(Path(workspace).resolve())}"
    try:
        target.write_text(content, encoding="utf-8")
        return f"Wrote {len(content.encode('utf-8'))} bytes to {target.relative_to(Path(workspace).resolve())}"
    except OSError as exc:
        return f"Write failed: {exc}"



def _sha256_file(path):
    digest=hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024*1024), b""):
            digest.update(chunk)
    return digest.hexdigest()



def _load_undo():
    try:
        data=json.loads(UNDO_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except (OSError, ValueError, json.JSONDecodeError):
        return []


def _save_undo(entries):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    UNDO_FILE.write_text(json.dumps(entries[-UNDO_LIMIT:], indent=2), encoding="utf-8")
    try: os.chmod(UNDO_FILE, 0o600)
    except OSError: pass


def _record_undo(entry):
    entries=_load_undo()
    entries.append(entry)
    dropped=entries[:-UNDO_LIMIT]
    entries=entries[-UNDO_LIMIT:]
    _save_undo(entries)
    for old in dropped:
        trash=old.get("trash")
        if trash:
            try:
                p=Path(trash)
                if p.is_dir(): shutil.rmtree(p)
                elif p.exists(): p.unlink()
            except OSError:
                pass


def _undo_last():
    entries=_load_undo()
    if not entries:
        print("LOOK undo · nothing to undo")
        return 1
    entry=entries[-1]
    kind=entry.get("kind")
    try:
        if kind=="copy":
            dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("copied destination no longer exists")
            expected=entry.get("sha256")
            if expected and dst.is_file() and _sha256_file(dst) != expected:
                raise RuntimeError("copied file has changed; refusing to remove it")
            if dst.is_dir(): shutil.rmtree(dst)
            else: dst.unlink()
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"removed copied {dst.name}"
        elif kind=="move":
            src=Path(entry["source"]); dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("moved path no longer exists")
            if src.exists():
                raise RuntimeError("original location is occupied")
            shutil.move(str(dst), str(src))
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"{dst.name} → {src}"
        elif kind=="remove":
            original=Path(entry["source"]); trash=Path(entry["trash"])
            if original.exists():
                raise RuntimeError("original location is occupied")
            if not trash.exists():
                raise RuntimeError("recoverable item is no longer available")
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(trash), str(original))
            detail=f"{original.name} restored"
        elif kind=="mkdir":
            path=Path(entry["path"])
            if not path.exists():
                raise RuntimeError("directory no longer exists")
            if not path.is_dir() or any(path.iterdir()):
                raise RuntimeError("directory is no longer empty; refusing to remove it")
            path.rmdir()
            detail=f"removed empty {path.name}/"
        elif kind=="batch":
            items=entry.get("items",[])
            for item in reversed(items):
                ik=item.get("kind")
                if ik=="copy":
                    dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    expected=item.get("sha256")
                    if expected and dst.is_file() and _sha256_file(dst)!=expected:
                        raise RuntimeError(f"{dst.name} changed; refusing batch undo")
                    if dst.is_dir(): shutil.rmtree(dst)
                    else: dst.unlink()
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="move":
                    src=Path(item["source"]); dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    if src.exists(): raise RuntimeError(f"{src} is occupied")
                    shutil.move(str(dst),str(src))
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="remove":
                    original=Path(item["source"]); trash=Path(item["trash"])
                    if original.exists(): raise RuntimeError(f"{original} is occupied")
                    if not trash.exists(): raise RuntimeError(f"{original.name} is no longer recoverable")
                    original.parent.mkdir(parents=True,exist_ok=True)
                    shutil.move(str(trash),str(original))
            detail=f"{len(items)} items restored"
        else:
            raise RuntimeError("unknown undo record")
    except (OSError, RuntimeError) as exc:
        print(f"{_c('✗','31')} LOOK undo · refused · {exc}")
        return 1
    entries.pop()
    _save_undo(entries)
    print(f"{_c('↶ UNDO','1;32')} · {kind}")
    print(f"  {detail}")
    return 0





def _batch_action(kind, destination, paths):
    """Perform several LOOK mutations but expose them as one undo transaction."""
    before=_load_undo()
    before_len=len(before)
    results=[]
    try:
        if kind in {"copy","move"}:
            dest=Path(destination).expanduser()
            # Multiple sources always target a directory.
            if len(paths)>1:
                raw=str(destination)
                if not raw.endswith(("/",os.sep)):
                    raw+=os.sep
                destination=raw
            for raw in paths:
                result=_interactive_file_action(kind,raw,destination)
                if not result.startswith(("COPY OK","MOVE OK")):
                    raise RuntimeError(result)
                results.append(result)
        elif kind=="remove":
            for raw in paths:
                result=_journal_remove(raw)
                if not result.startswith("REMOVE OK"):
                    raise RuntimeError(result)
                results.append(result)
        else:
            raise RuntimeError("unknown batch action")

        after=_load_undo()
        created=after[before_len:]
        if len(created)!=len(paths):
            raise RuntimeError("undo journal mismatch")
        combined=before+[{"kind":"batch","items":created,"time":time.time()}]
        _save_undo(combined)
        print(f"{kind.upper()} OK · {len(paths)} item{'s' if len(paths)!=1 else ''} · undo available · lk undo")
        return 0
    except RuntimeError as exc:
        # Roll back only mutations created by this batch. A failed batch should
        # not leave half an operation behind or pollute the user's undo stack.
        while len(_load_undo())>before_len:
            if _undo_last()!=0:
                break
        print(f"{_c('✗','31')} {kind.upper()} failed · {exc}")
        return 1


def _interactive_file_action(kind, src, dest):
    action=_journal_copy if kind=="copy" else _journal_move
    result=action(src,dest)
    if result.startswith("CREATE_DIR_REQUIRED · "):
        needed=result.split(" · ",1)[1]
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return result
        try:
            answer,cancelled=_prompt_line(
                f"{needed} does not exist\nM create directory and continue · Esc/Enter cancel › "
            )
        except KeyboardInterrupt:
            return "· cancelled"
        if cancelled or answer.strip().lower()!="m":
            return "· cancelled"
        result=action(src,dest,create_missing=True)
    return result


def _prompt_line(prompt):
    """Read one short action value; bare Esc cancels without Ctrl-C."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        try:
            return input(prompt),False
        except (EOFError,KeyboardInterrupt):
            return '',True
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    chars=[]
    try:
        tty.setcbreak(fd)
        sys.stdout.write(prompt); sys.stdout.flush()
        while True:
            ch=os.read(fd,1)
            if ch==b'\x1b':
                sys.stdout.write('\n'); sys.stdout.flush()
                return '',True
            if ch in {b'\r',b'\n'}:
                sys.stdout.write('\n'); sys.stdout.flush()
                return ''.join(chars),False
            if ch in {b'\x7f',b'\b'}:
                if chars:
                    chars.pop()
                    sys.stdout.write('\b \b'); sys.stdout.flush()
                continue
            if ch==b'\x03':
                raise KeyboardInterrupt
            text=ch.decode('utf-8','ignore')
            if text and text.isprintable():
                chars.append(text)
                sys.stdout.write(text); sys.stdout.flush()
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)


def _action_result(text):
    """Color only the CLI presentation; tool/API text stays plain."""
    if not sys.stdout.isatty():
        return text
    success_prefixes=("COPY OK","MOVE OK","REMOVE OK","MKDIR OK")
    if text.startswith(success_prefixes):
        head, sep, tail=text.partition(" · ")
        return f"{_c('✓','32')} {_c(head,'1;32')}{sep}{tail}"
    if any(word in text.lower() for word in ("failed","refused","mismatch")):
        return f"{_c('✗','31')} {text}"
    return text


def _destination_plan(src, requested):
    raw=str(requested)
    req=Path(requested).expanduser().resolve()
    directory_intent=raw.endswith(("/", os.sep)) or (req.exists() and req.is_dir())
    dst=req/src.name if directory_intent else req
    needed_root=req if directory_intent else dst.parent
    return req,dst,directory_intent,needed_root


def _copy_variant(path):
    path=Path(path)
    if path.is_dir() or not path.suffix:
        base=path.name
        suffix=""
    else:
        base=path.stem
        suffix=path.suffix
    parent=path.parent
    candidate=parent/f"{base} copy{suffix}"
    number=2
    while candidate.exists():
        candidate=parent/f"{base} copy {number}{suffix}"
        number+=1
    return candidate


def _missing_directories(path):
    path=Path(path)
    missing=[]
    cursor=path
    while not cursor.exists():
        missing.append(cursor)
        parent=cursor.parent
        if parent==cursor:
            break
        cursor=parent
    return list(reversed(missing))


def _make_missing_directories(path):
    created=[]
    for folder in _missing_directories(path):
        folder.mkdir()
        created.append(str(folder))
    return created


def _cleanup_created_dirs(paths):
    for raw in reversed(paths or []):
        p=Path(raw)
        try:
            if p.is_dir() and not any(p.iterdir()):
                p.rmdir()
        except OSError:
            pass


def _journal_copy(src, requested_destination, create_missing=False):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Copy failed: source not found: {src}"
    if dst==src and req.exists() and req.is_dir():
        dst=_copy_variant(src)
        needed_root=dst.parent
    elif dst.exists():
        return f"Copy refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        if src.is_dir():
            shutil.copytree(src,dst,copy_function=shutil.copy2)
            files=sum(1 for p in dst.rglob("*") if p.is_file())
            _record_undo({"kind":"copy","destination":str(dst),"created_dirs":created,"time":time.time()})
            return f"COPY OK · {src.name} → {dst} · directory · {files} files · undo available · lk undo"
        shutil.copy2(src,dst)
        source_hash=_sha256_file(src); destination_hash=_sha256_file(dst)
        if source_hash != destination_hash:
            try: dst.unlink()
            except OSError: pass
            _cleanup_created_dirs(created)
            return "Copy verification failed: SHA-256 mismatch; destination was removed."
        _record_undo({"kind":"copy","destination":str(dst),"sha256":destination_hash,"created_dirs":created,"time":time.time()})
        return f"COPY OK · {src.name} → {dst} · {src.stat().st_size} bytes · SHA-256 verified identical · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Copy failed: {exc}"


def _journal_move(src, requested_destination, create_missing=False):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Move failed: source not found: {src}"
    if dst.exists():
        return f"Move refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        shutil.move(str(src),str(dst))
        _record_undo({"kind":"move","source":str(src),"destination":str(dst),"created_dirs":created,"time":time.time()})
        return f"MOVE OK · {src.name} → {dst} · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Move failed: {exc}"



def _journal_remove(path):
    target=Path(path).expanduser().resolve()
    if not target.exists():
        return f"Remove failed: not found: {target}"
    if target == Path(target.anchor):
        return "Remove refused: filesystem root cannot be removed."
    try:
        UNDO_TRASH.mkdir(parents=True,exist_ok=True)
        token=f"{int(time.time()*1000)}-{uuid.uuid4().hex[:8]}"
        stash=UNDO_TRASH/token
        shutil.move(str(target),str(stash))
        _record_undo({"kind":"remove","source":str(target),"trash":str(stash),"time":time.time()})
        return f"REMOVE OK · {target.name} · recoverable · undo available · lk undo"
    except OSError as exc:
        return f"Remove failed: {exc}"


def _journal_mkdir(path):
    target=Path(path).expanduser().resolve()
    if target.exists():
        return f"Directory already exists: {target}" if target.is_dir() else f"Create directory failed: path exists as a file: {target}"
    try:
        target.mkdir(parents=True)
        _record_undo({"kind":"mkdir","path":str(target),"time":time.time()})
        return f"MKDIR OK · {target} · undo available · lk undo"
    except OSError as exc:
        return f"Create directory failed: {exc}"


def _tool_copy_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source)
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested))
    # Existing directory destination is allowed, but the resulting child must also remain inside workspace.
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final))
    return _journal_copy(src,dst)


def _tool_move_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source)
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested))
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final))
    return _journal_move(src,dst)


def _tool_remove_path(workspace, path, confirmed=False):
    target=_safe_workspace_path(workspace,path)
    if not confirmed:
        return "Remove refused: confirmed=true is required, and may be used only when the user explicitly asked to remove this path."
    if target == Path(workspace).resolve():
        return "Remove refused: the LOOK workspace root cannot be removed."
    return _journal_remove(target)


def _tool_make_directory(workspace, path):
    target=_safe_workspace_path(workspace,path)
    return _journal_mkdir(target)


